{
  "name": "truth-or-dare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "import:data": "node scripts/import-game-data.ts && node scripts/import-phone-data.ts",
    "predev": "npm run import:data",
    "dev": "vite",
    "prebuild": "npm run import:data",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "npm run import:data",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "npm run build && node scripts/test-pwa.ts",
    "test:importer": "vitest run scripts/xlsx/importer.test.ts",
    "test:watch": "vitest",
    "pretypecheck": "npm run import:data",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/brygada-1918": "5.3.0",
    "@fontsource/el-messiri": "5.3.0",
    "lucide-react": "1.34.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "24.13.3",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "exceljs": "4.4.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
